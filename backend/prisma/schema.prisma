generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Level {
  A1
  A2
  B1
  B2
  C1
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum VoiceGender {
  FEMALE
  MALE
}

model User {
  grammarAttempts  GrammarAttempt[]
  practiceSessions PracticeSession[]
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  name             String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  profile     UserProfile?
  roles       UserRole[]
  resetTokens PasswordResetToken[]
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users UserRole[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserProfile {
  id            String          @id @default(uuid())
  userId        String          @unique
  level         Level           @default(A1)
  goal          String?
  defaultVoice  VoiceGender     @default(FEMALE)
  defaultAccent String          @default("US")
  defaultSpeed  Float           @default(1.0)
  theme         ThemePreference @default(SYSTEM)
  dailyGoalMinutes Int          @default(15)
  avatarUrl     String?         @db.Text
  coverUrl      String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  INTERJECTION
  DETERMINER
  OTHER
}

enum RelationType {
  SYNONYM
  ANTONYM
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

model Category {
  practiceSessions PracticeSession[]
  id               String            @id @default(uuid())
  slug             String            @unique
  name             String
  description      String?
  sortOrder        Int               @default(0)
  targetCount      Int               @default(500)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  sentences Sentence[]
}

model DictionaryEntry {
  id           String        @id @default(uuid())
  headword     String        @unique
  phoneticIpa  String?
  phoneticEasy String?
  level        Level?
  forms        Json?
  source       String?
  license      String?
  status       ContentStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  senses      DictionarySense[]
  relations   WordRelation[]    @relation("EntryRelations")
  relatedFrom WordRelation[]    @relation("RelatedToEntries")

  @@index([headword(ops: raw("gin_trgm_ops"))], type: Gin, map: "DictionaryEntry_lemma_trgm_idx")
}

model DictionarySense {
  id           String       @id @default(uuid())
  entryId      String
  partOfSpeech PartOfSpeech
  meaningId    String
  definitionEn String?
  sortOrder    Int          @default(0)

  entry    DictionaryEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  examples DictionaryExample[]

  @@index([entryId])
}

model DictionaryExample {
  id        String  @id @default(uuid())
  senseId   String
  textEn    String
  textId    String
  sortOrder Int     @default(0)
  source    String?

  sense DictionarySense @relation(fields: [senseId], references: [id], onDelete: Cascade)

  @@index([senseId])
}

model WordRelation {
  id             String       @id @default(uuid())
  entryId        String
  relatedEntryId String
  type           RelationType

  entry        DictionaryEntry @relation("EntryRelations", fields: [entryId], references: [id], onDelete: Cascade)
  relatedEntry DictionaryEntry @relation("RelatedToEntries", fields: [relatedEntryId], references: [id], onDelete: Cascade)

  @@unique([entryId, relatedEntryId, type])
  @@index([relatedEntryId])
}

model Sentence {
  practiceAttempts PracticeAttempt[]
  id               String            @id @default(uuid())
  categoryId       String
  textEn           String
  textId           String
  phoneticIpa      String?
  phoneticEasy     String?
  level            Level             @default(A1)
  notes            String?
  source           String?
  status           ContentStatus     @default(DRAFT)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  category Category      @relation(fields: [categoryId], references: [id])
  tags     SentenceTag[]

  @@unique([categoryId, textEn])
  @@index([categoryId, level])
  @@index([status])
}

model Tag {
  id   String @id @default(uuid())
  name String @unique

  sentences SentenceTag[]
}

model SentenceTag {
  sentenceId String
  tagId      String

  sentence Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([sentenceId, tagId])
}

enum SessionMode {
  PRACTICE
  TEST
}

model PracticeSession {
  id         String      @id @default(uuid())
  userId     String
  categoryId String?
  mode       SessionMode @default(PRACTICE)
  startedAt  DateTime    @default(now())
  finishedAt DateTime?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attempts PracticeAttempt[]

  @@index([userId, startedAt])
}

model PracticeAttempt {
  id              String   @id @default(uuid())
  sessionId       String
  sentenceId      String
  spokenText      String
  wordScore       Float
  orderScore      Float
  confidenceScore Float?
  finalScore      Int
  label           String
  details         Json
  createdAt       DateTime @default(now())

  session  PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sentence Sentence        @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sentenceId])
}

enum GrammarQuestionType {
  MULTIPLE_CHOICE
  FILL_BLANK
}

model GrammarTopic {
  id          String        @id @default(uuid())
  slug        String        @unique
  title       String
  description String?
  level       Level
  status      ContentStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lessons   GrammarLesson[]
  questions GrammarQuestion[]
  attempts  GrammarAttempt[]

  @@index([status, level])
}

model GrammarLesson {
  id        String  @id @default(uuid())
  topicId   String
  title     String
  summary   String
  examples  String?
  sortOrder Int     @default(0)

  topic GrammarTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

model GrammarQuestion {
  id              String              @id @default(uuid())
  topicId         String
  type            GrammarQuestionType
  prompt          String
  explanation     String?
  level           Level
  status          ContentStatus       @default(DRAFT)
  sortOrder       Int                 @default(0)
  acceptedAnswers String[]

  topic   GrammarTopic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  options GrammarOption[]

  @@index([topicId, status])
}

model GrammarOption {
  id         String  @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  sortOrder  Int     @default(0)

  question GrammarQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model GrammarAttempt {
  id             String   @id @default(uuid())
  userId         String
  topicId        String
  score          Int
  correctCount   Int
  totalQuestions Int
  answers        Json
  createdAt      DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic GrammarTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([topicId])
}
