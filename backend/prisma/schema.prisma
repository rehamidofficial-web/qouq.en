generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Level {
  A1
  A2
  B1
  B2
  C1
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum VoiceGender {
  FEMALE
  MALE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile     UserProfile?
  roles       UserRole[]
  resetTokens PasswordResetToken[]
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users UserRole[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserProfile {
  id            String          @id @default(uuid())
  userId        String          @unique
  level         Level           @default(A1)
  goal          String?
  defaultVoice  VoiceGender     @default(FEMALE)
  defaultAccent String          @default("US")
  defaultSpeed  Float           @default(1.0)
  theme         ThemePreference @default(SYSTEM)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
