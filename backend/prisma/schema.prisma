generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Level {
  A1
  A2
  B1
  B2
  C1
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum VoiceGender {
  FEMALE
  MALE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile     UserProfile?
  roles       UserRole[]
  resetTokens PasswordResetToken[]
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users UserRole[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model UserProfile {
  id            String          @id @default(uuid())
  userId        String          @unique
  level         Level           @default(A1)
  goal          String?
  defaultVoice  VoiceGender     @default(FEMALE)
  defaultAccent String          @default("US")
  defaultSpeed  Float           @default(1.0)
  theme         ThemePreference @default(SYSTEM)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  INTERJECTION
  DETERMINER
  OTHER
}

enum RelationType {
  SYNONYM
  ANTONYM
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
}

model Category {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  targetCount Int      @default(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sentences Sentence[]
}

model DictionaryEntry {
  id           String        @id @default(uuid())
  headword     String        @unique
  phoneticIpa  String?
  phoneticEasy String?
  level        Level?
  forms        Json?
  source       String?
  license      String?
  status       ContentStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  senses      DictionarySense[]
  relations   WordRelation[]    @relation("EntryRelations")
  relatedFrom WordRelation[]    @relation("RelatedToEntries")
}

model DictionarySense {
  id           String       @id @default(uuid())
  entryId      String
  partOfSpeech PartOfSpeech
  meaningId    String
  definitionEn String?
  sortOrder    Int          @default(0)

  entry    DictionaryEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  examples DictionaryExample[]

  @@index([entryId])
}

model DictionaryExample {
  id        String @id @default(uuid())
  senseId   String
  textEn    String
  textId    String
  sortOrder Int    @default(0)

  sense DictionarySense @relation(fields: [senseId], references: [id], onDelete: Cascade)

  @@index([senseId])
}

model WordRelation {
  id             String       @id @default(uuid())
  entryId        String
  relatedEntryId String
  type           RelationType

  entry        DictionaryEntry @relation("EntryRelations", fields: [entryId], references: [id], onDelete: Cascade)
  relatedEntry DictionaryEntry @relation("RelatedToEntries", fields: [relatedEntryId], references: [id], onDelete: Cascade)

  @@unique([entryId, relatedEntryId, type])
  @@index([relatedEntryId])
}

model Sentence {
  id           String        @id @default(uuid())
  categoryId   String
  textEn       String
  textId       String
  phoneticIpa  String?
  phoneticEasy String?
  level        Level         @default(A1)
  notes        String?
  source       String?
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  category Category      @relation(fields: [categoryId], references: [id])
  tags     SentenceTag[]

  @@unique([categoryId, textEn])
  @@index([categoryId, level])
  @@index([status])
}

model Tag {
  id   String @id @default(uuid())
  name String @unique

  sentences SentenceTag[]
}

model SentenceTag {
  sentenceId String
  tagId      String

  sentence Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([sentenceId, tagId])
}
